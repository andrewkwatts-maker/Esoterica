__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
target/
Cargo.lock

# Compiled extension built in place by `maturin develop` / `maturin build`.
# It is a build output, and a stale one committed here is exactly what the
# version handshake in src/esoterica/_backend.py exists to catch.
*.pyd
*.so
*.dylib
*.pdb
.venv/
venv/

# Firebase credentials — NEVER commit these
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
serviceAccountKey.json
credentials*.json
*-credentials.json

# Baked data ships as a GitHub Release asset, not in git
src/esoterica/_data/*.db.gz
src/esoterica/_data/*.db

